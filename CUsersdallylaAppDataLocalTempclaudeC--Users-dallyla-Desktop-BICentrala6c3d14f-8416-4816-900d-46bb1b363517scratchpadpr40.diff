+        Layout Orgânico
+      </button>
+      <button 
+        type="button" 
+        class="control-btn" 
+        [class.active]="layoutGrafo === 'circular'"
+        (click)="alternarLayout('circular')">
+        Layout Circular
+      </button>
+    </div>

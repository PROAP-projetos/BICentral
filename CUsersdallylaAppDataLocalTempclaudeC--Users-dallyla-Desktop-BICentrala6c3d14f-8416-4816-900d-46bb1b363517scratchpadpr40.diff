+    <div class="header-info">
+      <div class="grafo-badge">
+        <span class="live-dot"></span>
+        <span class="badge-text">VISÃO GERAL DO ECOSSISTEMA</span>
+      </div>
+      <h2 class="header-title">Grafo de Conexões e Atividades</h2>
+      <p class="header-sub">Mapeamento interativo de processos e dependências por Unidade Gestora (PAT)</p>
+    </div>
+
+    <!-- SELETOR MULTI-SELECT DE UGS POR CORES -->
+    <div class="ug-filters-bar">
+      <span class="filters-label">Filtrar UGs:</span>
+      <div class="filters-list">
+        <button 
+          type="button"
+          class="ug-pill-btn"
+          *ngFor="let ug of ugsFiltro"
+          [class.ativa]="ug.ativa"

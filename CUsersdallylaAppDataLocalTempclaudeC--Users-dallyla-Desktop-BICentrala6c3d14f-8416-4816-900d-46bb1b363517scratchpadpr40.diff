+          class="switch-btn" 
+          [class.active]="modoVisualizacao === 'cards'"
+          (click)="alternarModo('cards')">
+          Cards Animados
+        </button>
+        <button 
+          type="button" 
+          class="switch-btn" 
+          [class.active]="modoVisualizacao === 'echarts'"
+          (click)="alternarModo('echarts')">
+          ECharts Bar
+        </button>
+      </div>
+    </div>
+  </header>
+
+  <!-- LINHA DE CARDS KPI (MÉTRICAS EXECUTIVAS GLOBAIS) -->
+  <section class="kpi-grid">
+    <div class="kpi-card">
+      <div class="kpi-icon-wrap kpi-blue">🎯</div>
+      <div class="kpi-details">
+        <span class="kpi-label">Execução Global PAT</span>
+        <div class="kpi-value-row">
+          <span class="kpi-value">{{ percentualGlobal }}%</span>
+          <span class="kpi-badge positive">+4.2% mês</span>
+        </div>
+        <div class="kpi-progress">
+          <div class="kpi-progress-bar" [style.width.%]="percentualGlobal"></div>
+        </div>
+      </div>
+    </div>
+
+    <div class="kpi-card">
+      <div class="kpi-icon-wrap kpi-purple">🏢</div>
+      <div class="kpi-details">
+        <span class="kpi-label">UGs Monitoradas</span>
+        <div class="kpi-value-row">
+          <span class="kpi-value">{{ ugs.length }}</span>
+          <span class="kpi-badge neutral">100% ativas</span>
+        </div>
+        <span class="kpi-subtext">Pró-Reitorias & Diretorias</span>
+      </div>
+    </div>
+
+    <div class="kpi-card">
+      <div class="kpi-icon-wrap kpi-green">✅</div>
+      <div class="kpi-details">
+        <span class="kpi-label">Tarefas Concluídas</span>
+        <div class="kpi-value-row">
+          <span class="kpi-value">{{ totalConcluidasGlobal }}/{{ totalTarefasGlobal }}</span>
+          <span class="kpi-badge positive">{{ (totalConcluidasGlobal / totalTarefasGlobal * 100) | number:'1.0-0' }}%</span>
+        </div>
+        <span class="kpi-subtext">Metas e entregas registradas</span>

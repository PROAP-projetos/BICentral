+
+/* ==========================================
+   COCKPIT LAYOUT EM 2 COLUNAS (60% / 40%)
+   ========================================== */
+
+.cockpit-layout {
+  display: grid;
+  grid-template-columns: 1.4fr 1fr;
+  gap: 1.25rem;
+  align-items: start;
+}
+
+.cockpit-column {
+  background: var(--bg-main, #ffffff);
+  border: 1px solid var(--border-color, #e5e7eb);
+  border-radius: 14px;
+  padding: 1.15rem;
+  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
+}
+
+.section-card-header {
+  display: flex;
+  justify-content: space-between;
+  align-items: center;
+  margin-bottom: 1rem;
+  padding-bottom: 0.65rem;
+  border-bottom: 1px solid var(--border-color, #e5e7eb);
+}
+
+.section-title-wrap {
+  display: flex;
+  align-items: center;
+  gap: 0.5rem;
+}
+
+.section-badge-icon {
+  font-size: 1.1rem;
+}
+
+.section-title-wrap h3 {
+  font-size: 0.96rem;
+  font-weight: 700;
+  margin: 0;
+  color: var(--text-primary);
+}
+
+.section-hint {
+  font-size: 0.72rem;
+  color: var(--text-secondary);
+}
+
+/* ==========================================
+   LEADERBOARD CARDS
+   ========================================== */
+
+.leaderboard-grid {
+  display: flex;
+  flex-direction: column;
+  gap: 0.55rem;
+}
+
+.ug-card {
+  display: flex;
+  align-items: center;
+  gap: 0.75rem;
+  padding: 0.7rem 0.9rem;
+  background: var(--bg-input, #f4f4f4);
+  border: 1px solid var(--border-color, #e5e7eb);
+  border-radius: 10px;
+  cursor: pointer;
+  transition: transform 0.6s cubic-bezier(0.34, 1.56, 0.64, 1),
+              background 0.3s ease,
+              border-color 0.3s ease,
+              box-shadow 0.3s ease;
+}
+
+.ug-card:hover {
+  border-color: #0284c7;
+  transform: translateX(4px);
+  box-shadow: 0 4px 14px rgba(2, 132, 199, 0.15);
+}
+
+.ug-card.rank-top1 {
+  background: linear-gradient(90deg, rgba(234, 179, 8, 0.12) 0%, var(--bg-input) 100%);
+  border-color: rgba(234, 179, 8, 0.45);
+}
+
+.ug-card.rank-top2 {
+  background: linear-gradient(90deg, rgba(148, 163, 184, 0.12) 0%, var(--bg-input) 100%);
+  border-color: rgba(148, 163, 184, 0.45);
+}
+
+.ug-card.rank-top3 {
+  background: linear-gradient(90deg, rgba(217, 119, 6, 0.12) 0%, var(--bg-input) 100%);
+  border-color: rgba(217, 119, 6, 0.45);
+}
+
+.ug-card.subiu-destaque {
+  animation: glow-pulse 2.2s ease-in-out;
+}
+
+@keyframes glow-pulse {
+  0% { box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.8); border-color: #10b981; }
+  50% { box-shadow: 0 0 16px 4px rgba(16, 185, 129, 0.5); border-color: #10b981; }
+  100% { box-shadow: none; }
+}
+
+.ug-rank-badge {
+  width: 30px;
+  height: 30px;
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  font-weight: 800;
+  font-size: 1.05rem;
+  flex-shrink: 0;
+}
+
+.rank-number {
+  font-size: 0.85rem;
+  color: var(--text-secondary);
+  font-weight: 700;
+}
+
+.ug-trend-indicator {
+  min-width: 42px;
+  flex-shrink: 0;
+}
+
+.trend-badge {
+  font-size: 0.7rem;
+  font-weight: 700;
+  padding: 0.15rem 0.35rem;
+  border-radius: 4px;
+  display: inline-block;
+}
+
+.trend-badge.subiu { background: rgba(16, 185, 129, 0.15); color: #10b981; }
+.trend-badge.caiu { background: rgba(239, 68, 68, 0.15); color: #ef4444; }
+.trend-badge.neutro { background: rgba(148, 163, 184, 0.15); color: var(--text-secondary); }
+
+.ug-info {
+  flex-grow: 1;
+  display: flex;
+  flex-direction: column;
+  gap: 0.3rem;
+  min-width: 0;
+}
+
+.ug-title-row {
+  display: flex;
+  align-items: baseline;
+  gap: 0.5rem;
+  overflow: hidden;
+}
+
+.ug-sigla {
+  font-weight: 800;
+  font-size: 0.92rem;
+  color: var(--text-primary);
+}
+
+.ug-nome {
+  font-size: 0.78rem;
+  color: var(--text-secondary);
+  white-space: nowrap;
+  overflow: hidden;
+  text-overflow: ellipsis;
+}
+
+.progress-track {
+  width: 100%;
+  height: 6px;
+  background: var(--border-color);
+  border-radius: 999px;
+  overflow: hidden;
+}
+
+.progress-fill {
+  height: 100%;
+  border-radius: 999px;
+  transition: width 0.8s cubic-bezier(0.4, 0, 0.2, 1);
+}
+
+.progress-fill.pct-alto { background: linear-gradient(90deg, #059669, #10b981); }
+.progress-fill.pct-medio { background: linear-gradient(90deg, #0284c7, #38bdf8); }
+.progress-fill.pct-baixo { background: linear-gradient(90deg, #ea580c, #f97316); }
+
+.ug-metrics {
+  text-align: right;
+  flex-shrink: 0;
+  min-width: 85px;
+}
+
+.metric-pct {
+  font-size: 1.05rem;
+  font-weight: 800;
+  line-height: 1;
+}
+
+.metric-pct.pct-alto { color: #10b981; }
+.metric-pct.pct-medio { color: #0284c7; }
+.metric-pct.pct-baixo { color: #f97316; }
+
+.metric-sub {
+  font-size: 0.68rem;
+  color: var(--text-secondary);
+  margin-top: 0.25rem;
+}
+
+.echarts-wrap {
+  height: 380px;
+  width: 100%;
+}
+
+.echarts-chart {
+  width: 100%;
+  height: 100%;
+}
+
+/* ==========================================
+   FEED DE ATIVIDADES RECENTES
+   ========================================== */
+
+.feed-column {
+  display: flex;
+  flex-direction: column;
+  gap: 1.25rem;
+}
+
+.activity-list {
+  display: flex;
+  flex-direction: column;
+  gap: 0.65rem;
+}
+
+.activity-item {
+  display: flex;
+  gap: 0.75rem;
+  padding: 0.65rem 0.8rem;
+  background: var(--bg-input, #f4f4f4);
+  border: 1px solid var(--border-color, #e5e7eb);
+  border-radius: 8px;
+  cursor: pointer;
+  transition: all 0.2s ease;
+}
+
+.activity-item:hover {
+  border-color: #0284c7;
+  background: var(--bg-sidebar-hover);
+  transform: translateX(3px);
+}
+
+.activity-status-dot {
+  width: 8px;
+  height: 8px;
+  border-radius: 50%;
+  margin-top: 0.35rem;
+  flex-shrink: 0;
+}
+
+.activity-status-dot.concluida { background: #10b981; box-shadow: 0 0 6px rgba(16, 185, 129, 0.6); }
+.activity-status-dot.atencao { background: #f97316; box-shadow: 0 0 6px rgba(249, 115, 22, 0.6); }
+.activity-status-dot.em_andamento { background: #0284c7; box-shadow: 0 0 6px rgba(2, 132, 199, 0.6); }
+
+.activity-content {
+  flex-grow: 1;
+  min-width: 0;
+  display: flex;
+  flex-direction: column;
+  gap: 0.2rem;
+}
+
+.activity-header-row {
+  display: flex;
+  justify-content: space-between;
+  align-items: center;
+}
+
+.activity-ug-badge {
+  font-size: 0.72rem;
+  font-weight: 800;
+  color: #0284c7;
+}
+
+.activity-time {
+  font-size: 0.68rem;
+  color: var(--text-secondary);
+}
+
+.activity-title {
+  margin: 0;
+  font-size: 0.78rem;
+  font-weight: 600;
+  color: var(--text-primary);
+  line-height: 1.3;
+}
+
+.activity-meta {
+  display: flex;
+  justify-content: space-between;
+  align-items: center;
+  margin-top: 0.15rem;
+  font-size: 0.68rem;
+  color: var(--text-secondary);
+}
+
+.activity-tag {
+  background: var(--bg-main);
+  padding: 0.1rem 0.35rem;
+  border-radius: 4px;
+  border: 1px solid var(--border-color);
+  font-weight: 600;
+}
+
+/* ==========================================
+   INSIGHTS E CHIPS DA IA
+   ========================================== */
+
+.insights-grid {
+  display: grid;
+  grid-template-columns: 1fr 1fr;
+  gap: 0.6rem;
+}
+
+.insight-chip {
+  padding: 0.65rem 0.75rem;
+  background: var(--bg-input, #f4f4f4);
+  border: 1px solid var(--border-color, #e5e7eb);
+  border-radius: 8px;
+  cursor: pointer;
+  display: flex;
+  flex-direction: column;
+  gap: 0.35rem;
+  transition: all 0.2s ease;
+}
+
+.insight-chip:hover {
+  border-color: #8b5cf6;
+  background: rgba(139, 92, 246, 0.08);
+  transform: translateY(-2px);
+}
+
+.insight-chip-header {
+  display: flex;
+  justify-content: space-between;
+  align-items: center;
+}
+
+.insight-icon {
+  font-size: 1rem;
+}
+
+.insight-badge {
+  font-size: 0.62rem;
+  font-weight: 700;
+  text-transform: uppercase;
+  color: #8b5cf6;
+  background: rgba(139, 92, 246, 0.12);
+  padding: 0.1rem 0.3rem;
+  border-radius: 4px;
+}
+
+.insight-title {
+  font-size: 0.74rem;
+  font-weight: 700;
+  color: var(--text-primary);
+  line-height: 1.25;
+}
+
+/* ==========================================
+   RESPONSIVIDADE
+   ========================================== */
+
+@media (max-width: 1200px) {
+  .kpi-grid {
+    grid-template-columns: repeat(2, 1fr);
+  }
+
+  .cockpit-layout {
+    grid-template-columns: 1fr;
+  }
+}
+
+@media (max-width: 768px) {
+  .kpi-grid {
+    grid-template-columns: 1fr;
+  }
+
+  .insights-grid {
+    grid-template-columns: 1fr;
+  }
+}

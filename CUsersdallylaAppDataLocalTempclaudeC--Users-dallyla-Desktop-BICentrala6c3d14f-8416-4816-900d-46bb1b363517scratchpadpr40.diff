+<div class="intelligence-board-container">
+  
+  <!-- CABEÇALHO DO HUB DE INTELIGÊNCIA -->
+  <header class="board-header">
+    <div class="header-main-title">
+      <div class="live-indicator">
+        <span class="pulse-dot"></span>
+        <span class="live-text">PROIAP · EXECUTIVE COMMAND CENTER</span>
+      </div>
+      <h2>Painel Geral de Inteligência & Desempenho</h2>
+      <p class="subtitle">Monitoramento em tempo real das Pró-Reitorias, Diretorias e Metas do PAT</p>
+    </div>
+
+    <div class="header-actions">

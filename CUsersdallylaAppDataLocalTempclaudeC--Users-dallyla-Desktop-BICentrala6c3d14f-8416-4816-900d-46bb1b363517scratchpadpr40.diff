+    </div>
+
+    <div class="kpi-card">
+      <div class="kpi-icon-wrap" [ngClass]="totalUgsEmAtencao > 0 ? 'kpi-orange' : 'kpi-green'">
+        {{ totalUgsEmAtencao > 0 ? '⚠️' : '🛡️' }}
+      </div>
+      <div class="kpi-details">
+        <span class="kpi-label">UGs em Atenção</span>
+        <div class="kpi-value-row">
+          <span class="kpi-value">{{ totalUgsEmAtencao }}</span>
+          <span class="kpi-badge" [ngClass]="totalUgsEmAtencao > 0 ? 'warning' : 'positive'">

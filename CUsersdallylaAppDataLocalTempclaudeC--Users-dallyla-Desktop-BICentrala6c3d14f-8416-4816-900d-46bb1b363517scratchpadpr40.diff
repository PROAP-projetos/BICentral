+:host {
+  display: block;
+  width: 100%;
+}
+
+.intelligence-board-container {
+  display: flex;
+  flex-direction: column;
+  gap: 1.25rem;
+  width: 100%;
+  color: var(--text-primary, #0d0d0d);
+  padding-bottom: 2rem;
+}
+
+/* ==========================================
